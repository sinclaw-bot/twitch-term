{
  "name": "twitch-term",
  "version": "1.0.0",
  "description": "Split-screen Twitch chat terminal client — scroll chat above, type messages below, all in one terminal.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "twitch-term": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "watch": "tsx watch src/index.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/"
  },
  "keywords": ["twitch", "chat", "terminal", "cli", "irc"],
  "author": "sinclaw-bot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinclaw-bot/twitch-term.git"
  },
  "dependencies": {
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
